---
import SeoHead from '../components/v2/SeoHead.astro';
import Navbar from "../components/Navbar.astro"
import Footer from "../components/Footer.astro"

import '../styles/markdown.css'
const { frontmatter } = Astro.props;
const iso = (d) => { const t = Date.parse(d); return isNaN(t) ? undefined : new Date(t).toISOString().slice(0, 10); };
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: frontmatter.title,
  description: frontmatter.description,
  image: frontmatter.image?.url ? new URL(frontmatter.image.url, 'https://holisticancercoach.com').href : undefined,
  datePublished: iso(frontmatter.pubDate) ?? iso(frontmatter.date),
  author: { '@type': 'Organization', name: 'Holistic Cancer Treatments Coach' },
  publisher: { '@type': 'Organization', name: 'Holistic Cancer Treatments Coach', logo: { '@type': 'ImageObject', url: 'https://holisticancercoach.com/holisticsvf.svg' } },
  mainEntityOfPage: new URL(Astro.url.pathname, 'https://holisticancercoach.com').href,
};
---

<!doctype html>
<html lang="en">
	<head>
		<SeoHead lang="en" type="article" title={frontmatter.title} description={frontmatter.description} image={frontmatter.image?.url ? new URL(frontmatter.image.url, "https://holisticancercoach.com").href : undefined} />
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
	</head>
	<body>
		<Navbar solid/>

		
    <main>
    <div class="postcontent">
             <span class="breadcrumb"><a href="/blog">Blog</a> / {frontmatter.title}</span>
				<div class="img-cont">
<img src={frontmatter.image.url} width="1200" height="675" alt={frontmatter.title} fetchpriority="high" style="margin-top:2rem;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;"/>
				</div>
                
                <h1 style="font-size:2rem;">{frontmatter.title}</h1>
                <p style="font-size:1rem;font-weight:bold;text-align: center;color:#0A7A80;">{frontmatter.author}</p>
             
				<div class="audio">

				
			{frontmatter.audio && (
				<div class="audio-player">
					<div class="audio-header">
						<i class="bi bi-headphones"></i>
						<span>Listen to it</span>
					</div>
					<audio controls preload="metadata">
						<source src={frontmatter.audio} type={frontmatter.audio.endsWith(".wav") ? "audio/wav" : "audio/mpeg"} />
						Tu navegador no soporta el elemento de audio.
					</audio>
				</div>
			)}
			</div>
                <slot />
            </div>
		</main>
	<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
