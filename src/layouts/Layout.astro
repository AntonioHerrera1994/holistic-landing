---
import SeoHead from '../components/v2/SeoHead.astro';

interface Props {
	title?: string;
	description?: string;
	lang?: 'en' | 'es';
	image?: string;
	noindex?: boolean;
}
const {
	title = 'Holistic Cancer Treatments Coach | Integrative Complementary Care in Tijuana',
	description = 'Integrative, complementary therapies in Tijuana, Baja California, designed to work alongside conventional cancer treatment.',
	lang = 'en',
	image,
	noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
	<head>
		<SeoHead title={title} description={description} lang={lang} image={image} noindex={noindex} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html, body { margin: 0; width: 100%; }
	body { background: var(--cream); -webkit-font-smoothing: antialiased; }
	html { scroll-behavior: smooth; }
</style>
