---
import '../styles/posibilidades.css'
import Pilares from '../components/Circulo.astro'
import ImgDent from '../assets/dra-dent.webp'
---

<section class="posib">
    <div class="posib-grid">
        <div class="ps1">
            <h2>Elevate Your Healing: The Benefits of <span class="highlight-text">Holistic Complementary</span> Care</h2>
            <p>At Holistic Cancer Treatment, we believe in a comprehensive approach to cancer care that extends beyond conventional treatments. Our holistic alternative therapies are designed to work in synergy with your primary medical plan, offering a powerful accompaniment that addresses your entire well-being – mind, body, and spirit.</p>
            <a href="/contact-us">
                <button class="learn-more">
                    <span class="circle" aria-hidden="true">
                        <span class="icon arrow"></span>
                    </span>
                    <span class="button-text">Contact Us</span>
                </button>
            </a>
        </div>
        <div class="ps2">
            <Pilares />
        </div>
    </div>
</section>

<section class="reserva">
    <div class="reserva-inner">
        <div class="reserva-cont">
            <div class="reserva-txt">
                <span class="save-badge">Save up to 70%</span>
                <h2>Premium Dental Care at Unbeatable Prices: Explore Our Services</h2>
                <p>Discover why thousands of patients choose Biodental for their dental needs. Located in Tijuana, Baja California, our modern clinic offers the same quality treatments you'd find in the US—at a fraction of the cost. Schedule a visit to meet our skilled dental professionals, tour our advanced facility, and learn how you can save up to 70% on your dental care.</p>
                <div class="reserva-btn">
                    <a href="https://holisticancercoach.com/dental-prices/" class="dental-cta">
                        <span>View Dental Pricing</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14M13 6l6 6-6 6"></path>
                        </svg>
                    </a>
                </div>
            </div>
            <div class="img-dra">
                <img src={ImgDent.src} alt="Dental professional at Biodental clinic" />
            </div>
        </div>
    </div>
</section>