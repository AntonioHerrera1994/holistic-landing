---
import TeamSlider from './v2/TeamSlider.astro'
import HeroHolistic from './v2/HeroHolistic.astro'
import '../styles/about/abouthero.css'
import DrHenriquez from '../assets/doctor.webp'
import Nutritionist from '../assets/opt/equipo2.webp'
import Gloria from '../assets/opt/gloria.webp'
import DraDentista from '../assets/opt/equipo1.webp'

const team = [
    {
        img: DrHenriquez,
        role: "Medical Director · Integrative Medicine", // REVISAR: "Cancer/Oncology Specialist" requiere cédula de especialidad; usar solo si la tiene
        name: "Dr. Jose A. Henriquez",
        badge: "Medical Director",
        bio: "Dr. Jose A. Henriquez has many years of experience in metabolic therapies and Whole Body Hyperthermia, applied as complementary approaches within personalized, medically supervised plans."
    },
    {
        img: Nutritionist,
        role: "Nutritionist",
        name: "RDN. Melissa Rivera",
        badge: "Nutrition",
        bio: "Certified in Nutrigenomics by the Instituto Nutrigenómica of Spain and certified in Nutrition Applied to Immunology, endorsed by the Colegio Mexicano de Nutriólogos."
    },
    {
        img: Gloria,
        role: "Treatment Advisor Clinic",
        name: "LCC. Gloria Alejo",
        badge: "Patient Care",
        bio: "With years of dedicated experience in patient care coordination, Gloria ensures every patient receives compassionate guidance and access to the right medical resources throughout their treatment journey."
    },
    {
        img: DraDentista,
        role: "Holistic Dentistry",
        name: "Dr. Gisselle Heredia",
        badge: "Dentistry",
        bio: "This holistic dental practice merges modern dentistry with natural, biocompatible methods, focusing on the mouth-body connection through minimally invasive, non-toxic treatments."
    }
];
---

<section class="ahero">
    <HeroHolistic />
    <div class="ahero-grid">
        <div class="ahero-copy">
        <span class="eyebrow">Our Team</span>
        <h1>Meet the Pillars of Your <span class="highlight-text">Healing</span> Journey</h1>
        <p>We are more than just a clinic; we are a dedicated family committed to your holistic well-being. Our multidisciplinary professionals bring together a wealth of experience in medical treatment, psychological support, and seamless administrative care, all united by a singular goal: to guide you with integrity and empathy through your treatment journey.</p>

        <div class="trust-chips">
            <span>Multidisciplinary Team</span>
            <span>Personalized Care Plans</span>
            <span>Bilingual Support</span>
        </div>

        <div class="ahero-buttons">
            <a href="/contact-us" class="primary-cta">Schedule a Consultation</a>
            <a href="/treatments" class="ghost-cta">View Our Treatments</a>
        </div>
        </div>
        <TeamSlider team={team} lang="en" />
    </div>
</section>

<script>
    import "../scripts/abouthero.js"
</script>