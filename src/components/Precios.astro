---
import '../styles/precios.css'

const procedures = [
  { name: "New Patient", category: "Diagnostics", biodental: 50, us: 100 },
  { name: "Panoramic Radiographic Image", category: "Diagnostics", biodental: 50, us: 100 },
  { name: "Full Mouth 3D CT Scan", category: "Diagnostics", biodental: 200, us: 500 },
  { name: "Prophylaxis (Cleaning)", category: "Preventive", biodental: 50, us: 80 },
  { name: "Resin-Based Composite Filling", category: "Restorative", biodental: 100, us: 150 },
  { name: "Safe Mercury Removal with Filling", category: "Restorative", biodental: 100, us: 300 },
  { name: "Inlay - Porcelain/Ceramic", category: "Restorative", biodental: 430, us: 650 },
  { name: "Onlay - Porcelain/Ceramic", category: "Restorative", biodental: 430, us: 650 },
  { name: "Crown - Porcelain/Ceramic (Emax)", category: "Restorative", biodental: 480, us: 1000 },
  { name: "Crown - Porcelain/Ceramic (Zirconia)", category: "Restorative", biodental: 480, us: 1200 },
  { name: "Temporary Crown", category: "Restorative", biodental: 75, us: 100 },
  { name: "Post and/or Build Up", category: "Restorative", biodental: 120, us: 250 },
  { name: "Endodontic Therapy, Premolar/Molar (excl. final restoration)", category: "Endodontics", biodental: 330, us: 750 },
  { name: "Endodontic Therapy, Premolar/Molar", category: "Endodontics", biodental: 350, us: 900 },
  { name: "Root Canal (incl. cleaning, post-build-up & zirconia crown)", category: "Endodontics", biodental: 880, us: 2500 },
  { name: "Deep Cleaning per Quadrant", category: "Periodontal", biodental: 100, us: 135 },
  { name: "Periodontal Surgery per Quadrant", category: "Periodontal", biodental: 500, us: 600 },
  { name: "Bone Replacement Graft (first site)", category: "Periodontal", biodental: 350, us: 500 },
  { name: "Biologic Materials for Tissue Regeneration (PRP-PRF)", category: "Periodontal", biodental: 100, us: 100 },
  { name: "Gingivectomy or Gingivoplasty", category: "Periodontal", biodental: 300, us: 200 },
  { name: "Complete Denture - Maxillary", category: "Dentures", biodental: 650, us: 1500 },
  { name: "Complete Denture - Mandibular", category: "Dentures", biodental: 650, us: 1500 },
  { name: "Immediate Denture - Maxillary", category: "Dentures", biodental: 350, us: 600 },
  { name: "Immediate Denture - Mandibular", category: "Dentures", biodental: 350, us: 600 },
  { name: "Surgical Placement of Implant Body", category: "Implants", biodental: 900, us: 2000 },
  { name: "Semi-Precision Attachment Abutment", category: "Implants", biodental: 350, us: 500 },
  { name: "Implant Abutment", category: "Implants", biodental: 350, us: 650 },
  { name: "Custom Fabricated Abutment", category: "Implants", biodental: 400, us: 800 },
  { name: "Implant Crown - Porcelain/Ceramic (Emax)", category: "Implants", biodental: 500, us: 1200 },
  { name: "Implant Crown - Porcelain/Ceramic (Zirconia)", category: "Implants", biodental: 500, us: 1500 },
  { name: "Sinus Augmentation - Lateral Approach", category: "Implants", biodental: 1300, us: 2500 },
  { name: "Sinus Augmentation - Vertical Approach", category: "Implants", biodental: 900, us: 1500 },
  { name: "Simple Extraction - Front Tooth", category: "Extractions", biodental: 100, us: 200 },
  { name: "Simple Extraction", category: "Extractions", biodental: 120, us: 200 },
  { name: "Extraction with Cavitation, Plasma & Ozone", category: "Extractions", biodental: 350, us: 600 },
  { name: "Wisdom Tooth Extraction", category: "Extractions", biodental: 150, us: 200 },
  { name: "Wisdom Tooth Extraction (Partially Bony)", category: "Extractions", biodental: 230, us: 240 },
  { name: "Wisdom Tooth Extraction (Completely Bony)", category: "Extractions", biodental: 300, us: 500 },
  { name: "Night Guard", category: "Other", biodental: 120, us: 200 },
  { name: "Veneers", category: "Cosmetic", biodental: 480, us: 1000 },
];

const categories = ["All", ...new Set(procedures.map(p => p.category))];
---

<div class="pricing-container">
    <div class="header-section">
        <h1 class="main-title">Affordable Holistic Dentist Prices in Tijuana, Mexico</h1>
        <p class="subtitle">Save significantly on dental procedures with world-class quality<sup>*</sup></p>
    </div>

    <div class="controls-bar">
        <div class="search-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            <input type="text" id="procedureSearch" placeholder="Search a procedure (e.g. crown, implant, cleaning)..." />
        </div>

        <div class="category-filters" id="categoryFilters">
            {categories.map((cat, i) => (
                <button class={`filter-pill ${i === 0 ? "active" : ""}`} data-category={cat}>{cat}</button>
            ))}
        </div>
    </div>

    <p class="results-count" id="resultsCount">Showing {procedures.length} of {procedures.length} procedures</p>

      <h2 id="pricing-h2" class="sr-only">Procedure prices</h2>
    <div class="pricing-grid" id="pricingGrid" aria-labelledby="pricing-h2">
        {procedures.map((procedure) => {
            const savings = procedure.us - procedure.biodental;
            const message = encodeURIComponent(`Hi! I'd like to schedule an appointment for: ${procedure.name}`);
            return (

                <a
                    href={`https://wa.link/nai5wo?text=${message}`}
                    target="_blank"
                    class="pricing-card"
                    data-name={procedure.name.toLowerCase()}
                    data-category={procedure.category}
                >
                    <span class="category-tag">{procedure.category}</span>
                    <h3 class="procedure-name">{procedure.name}</h3>

                    <div class="prices-comparison">
                        <div class="price-block biodental">
                            <span class="price-label">Our Price</span>
                            <span class="price-value">${procedure.biodental}</span>
                        </div>
                        <div class="vs-divider"><span>vs</span></div>
                        <div class="price-block us">
                            <span class="price-label">US Price</span>
                            <span class="price-value">${procedure.us}</span>
                        </div>
                    </div>

                    {savings > 0 ? (
                        <div class="savings-badge">
                            <span>You Save ${savings}</span>
                        </div>
                    ) : (
                        <div class="savings-badge neutral">
                            <span>Competitive Pricing</span>
                        </div>
                    )}

                    <span class="book-hint">
                        Book this procedure
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14M13 6l6 6-6 6"></path>
                        </svg>
                    </span>
                </a>
            );
        })}
    </div>

    <p class="no-results" id="noResults" style="display:none;">No procedures match your search. Try a different term or category.</p>

    <p class="disclaimer">*Savings compared to average U.S. pricing; actual savings vary by procedure and case.</p>


</div>

<script>
    import "../scripts/precios.js"
</script>