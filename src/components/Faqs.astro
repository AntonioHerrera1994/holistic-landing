---
import '../styles/services-styles/faqs.css'
import ImgDFaqs from '../assets/img3.webp'

const faqs = [
    {
        q: "Is holistic cancer treatment an alternative to conventional therapies?",
        a: "No, our holistic treatments are designed to complement and enhance conventional cancer therapies, not replace them. We focus on integrating approaches to support your overall well-being and strengthen your body during treatment."
    },
    {
        q: "What should I know about traveling to your clinic in Tijuana?",
        a: "Our clinic is conveniently located in Tijuana, Baja California, Mexico. We understand traveling for treatment can be daunting, and our team can provide guidance on travel arrangements, accommodation, and local information to ensure a smooth and comfortable visit."
    },
    {
        q: "Does your clinic accept health insurance for treatments?",
        a: "While many holistic treatments are not typically covered by standard health insurance plans, we will provide you with all necessary documentation for potential reimbursement from your provider. We also offer various payment options and transparently discuss all costs upfront."
    },
    {
        q: "What can I expect during my first consultation?",
        a: "Your initial consultation involves a comprehensive review of your medical history, current condition, and health goals. It's an opportunity to discuss potential treatment options, ask all your questions, and determine the most personalized path forward with our medical team."
    },
    {
        q: "How long do holistic treatment programs typically last?",
        a: "The duration of treatment varies greatly depending on your individual diagnosis, the complexity of your case, and your response to therapies. We will provide a clear, personalized timeline during your consultation, outlining the recommended program length."
    }
];

// FAQ Schema (JSON-LD) — sigue siendo valioso para citación en IA (AEO), aunque Google ya no muestre el rich result en buscador
const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": item.a
        }
    }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="faq">
    <div class="faq-cont">
        <div class="faq-grid">

            <div class="faq-izq">
                <img
                    src={ImgDFaqs.src}
                    width="600"
                    height="450"
                    alt="Holistic Cancer Treatments Coach clinic"
                    loading="lazy"
                />
                <div class="faq-badge">
                    <span>Still have questions?</span>
                    <a href="https://wa.link/nai5wo" target="_blank">Chat with us</a>
                </div>
            </div>

            <div class="accordion">
                <span class="eyebrow">FAQ</span>
                <h1>Frequently <span class="highlight-text">Asked</span> Questions</h1>

                {faqs.map((item, i) => (
                    <div class={`accordion-item ${i === 0 ? "active" : ""}`}>
                        <button class="accordion-button" aria-expanded={i === 0 ? "true" : "false"}>
                            <span>{item.q}</span>
                            <span class="accordion-icon" aria-hidden="true">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12h14M12 5v14"></path>
                                </svg>
                            </span>
                        </button>
                        <div class="accordion-content">
                            <p>{item.a}</p>
                        </div>
                    </div>
                ))}
            </div>

        </div>
    </div>
</section>

<script>
    import "../scripts/faqs.js"
</script>