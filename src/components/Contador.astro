---
import '../styles/contador.css'
---

<section class="contadorgrid">
    <div class="counter-card" data-accent="cyan">
        <div class="counter-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 4v6a4 4 0 0 0 8 0V4"></path>
                <path d="M18 9v2a6 6 0 0 1-12 0V9"></path>
                <circle cx="18" cy="6" r="2"></circle>
            </svg>
        </div>
        <h3 class="counter-title">Available Treatments</h3>
        <div class="counter" data-target="6">0</div>
    </div>

    <div class="counter-card" data-accent="pink">
        <div class="counter-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.5-1.5 3-3.3 3-5.5A4.5 4.5 0 0 0 17.5 4c-1.7 0-3 .8-4 2-1-1.2-2.3-2-4-2A4.5 4.5 0 0 0 5 8.5c0 2.2 1.5 4 3 5.5l6 6z"></path>
            </svg>
        </div>
        <h3 class="counter-title">Lives Transformed</h3>
        <div class="counter con-signo" data-target="100">0</div>
    </div>

    <div class="counter-card" data-accent="cyan">
        <div class="counter-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
        </div>
        <h3 class="counter-title">Years Of Experience</h3>
        <div class="counter con-signo" data-target="20">0</div>
    </div>
</section>

<script>
    import "../scripts/contador.js"
</script>