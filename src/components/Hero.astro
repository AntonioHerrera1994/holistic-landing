---
import '../styles/hero.css'
import Contador from './Contador.astro'
---

<section class="hero">
    <div class="hero-blob blob-1"></div>
    <div class="hero-blob blob-2"></div>

    <div class="hero-grid">
        <div class="hg1">
            <span class="eyebrow">Integrated Holistic Care</span>
            <h1>Integrated Holistic <span class="highlight">Cancer</span> Care</h1>
            <p>Discover a comprehensive and compassionate approach to cancer care that integrates traditional and alternative therapies. Our dedicated team provides personalized treatment plans, focusing on your overall well-being with round-the-clock support.</p>

            <div class="hero-buttons">
                <a href="/about-us">
                    <button class="learn-more">
                        <span class="circle" aria-hidden="true">
                            <span class="icon arrow"></span>
                        </span>
                        <span class="button-text">Learn More</span>
                    </button>
                </a>
                <a href="/treatments" class="ghost-button">View Treatments</a>
            </div>
        </div>

        <div class="hg2">
            <div class="chip chip-1">Advanced Immunotherapy</div>
            <div class="chip chip-2">Holistic Dentistry</div>
            <div class="chip chip-3">Stem Cell Therapy</div>
        </div>
    </div>
</section>

<section class="bajo">
    <div class="numbers">
        <h2>Empowering Lives: Our Patient Success Stories</h2>
        <div class="n1">
            <Contador />
        </div>
    </div>
</section>