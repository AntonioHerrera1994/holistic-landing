---
import TeamSlider from '../v2/TeamSlider.astro'
import HeroHolistic from '../v2/HeroHolistic.astro'
import '../../styles/about/abouthero.css'
import DrHenriquez from '../../assets/doctor.webp'
import Nutrioioga from '../../assets/opt/equipo2.webp'
import Gloria from '../../assets/opt/gloria.webp'
import DraDentista from '../../assets/opt/equipo1.webp'

const team = [
    {
        img: DrHenriquez,
        role: "Director Médico · Medicina Integrativa", // REVISAR: "Especialista en Oncología" requiere cédula de especialidad; usar solo si la tiene
        name: "Dr. Jose A. Henriquez",
        badge: "Director Médico",
        bio: "El Dr. José A. Henríquez cuenta con una amplia trayectoria en terapias metabólicas e Hipertermia Corporal Total, aplicadas como enfoques complementarios dentro de planes personalizados y supervisados médicamente."
    },
    {
        img: Nutrioioga,
        role: "Nutrióloga",
        name: "RDN. Melissa Rivera",
        badge: "Nutrición",
        bio: "Certificada en Nutrigenómica por el Instituto de Nutrigenómica de España y en Nutrición Aplicada a la Inmunología, avalada por el Colegio Mexicano de Nutriólogos."
    },
    {
        img: Gloria,
        role: "Asesora de Tratamientos",
        name: "LCC. Gloria Alejo",
        badge: "Atención al Paciente",
        bio: "Con años de trayectoria dedicada a la coordinación de atención al paciente, Gloria se asegura de que cada paciente reciba orientación compasiva y acceso a los recursos médicos adecuados a lo largo de su tratamiento."
    },
    {
        img: DraDentista,
        role: "Odontología Holística",
        name: "Dr. Gisselle Heredia",
        badge: "Odontología",
        bio: "Esta práctica de odontología holística fusiona la odontología moderna con métodos naturales y biocompatibles, enfocándose en la conexión boca-cuerpo a través de tratamientos mínimamente invasivos y libres de tóxicos."
    }
];
---

<section class="ahero">
    <HeroHolistic />
    <div class="ahero-grid">
        <div class="ahero-copy">
        <span class="eyebrow">Nuestro Equipo</span>
        <h1>Conozca a los Pilares de Su Proceso de <span class="highlight-text">Sanación</span></h1>
        <p>Somos más que una clínica; somos una familia comprometida con su bienestar integral. Nuestro equipo multidisciplinario reúne una vasta experiencia en tratamiento médico, apoyo psicológico y una gestión administrativa impecable, todos unidos por un único objetivo: acompañarlo con integridad y empatía a lo largo de su proceso oncológico.</p>

        <div class="trust-chips">
            <span>Equipo Multidisciplinario</span>
            <span>Planes Personalizados</span>
            <span>Atención Bilingüe</span>
        </div>

        <div class="ahero-buttons">
            <a href="/contacto" class="primary-cta">Agendar una Consulta</a>
            <a href="/tratamientos" class="ghost-cta">Ver Nuestros Tratamientos</a>
        </div>
        </div>
        <TeamSlider team={team} lang="es" />
    </div>
</section>

<script>
    import "../../scripts/abouthero.js"
</script>