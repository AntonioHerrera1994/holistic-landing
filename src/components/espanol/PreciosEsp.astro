---
import '../../styles/precios.css'

const procedures = [
  { name: "Paciente Nuevo", category: "Diagnóstico", biodental: 50, us: 100 },
  { name: "Radiografía Panorámica", category: "Diagnóstico", biodental: 50, us: 100 },
  { name: "Tomografía 3D de Boca Completa", category: "Diagnóstico", biodental: 200, us: 500 },
  { name: "Profilaxis (Limpieza)", category: "Preventivo", biodental: 50, us: 80 },
  { name: "Resina Compuesta", category: "Restaurativo", biodental: 100, us: 150 },
  { name: "Remoción Segura de Mercurio con Empaste", category: "Restaurativo", biodental: 100, us: 300 },
  { name: "Incrustación - Porcelana/Cerámica", category: "Restaurativo", biodental: 430, us: 650 },
  { name: "Onlay - Porcelana/Cerámica", category: "Restaurativo", biodental: 430, us: 650 },
  { name: "Corona - Porcelana/Cerámica (Emax)", category: "Restaurativo", biodental: 480, us: 1000 },
  { name: "Corona - Porcelana/Cerámica (Zirconia)", category: "Restaurativo", biodental: 480, us: 1200 },
  { name: "Corona Temporal", category: "Restaurativo", biodental: 75, us: 100 },
  { name: "Poste y/o Reconstrucción", category: "Restaurativo", biodental: 120, us: 250 },
  { name: "Endodoncia Premolar o Molar (sin restauración final)", category: "Endodoncia", biodental: 330, us: 750 },
  { name: "Endodoncia Premolar o Molar", category: "Endodoncia", biodental: 350, us: 900 },
  { name: "Endodoncia con Limpieza, Poste y Corona de Zirconia", category: "Endodoncia", biodental: 880, us: 2500 },
  { name: "Limpieza Profunda por Cuadrante", category: "Periodontal", biodental: 100, us: 135 },
  { name: "Cirugía Periodontal por Cuadrante", category: "Periodontal", biodental: 500, us: 600 },
  { name: "Injerto de Hueso Primer Sitio por Cuadrante", category: "Periodontal", biodental: 350, us: 500 },
  { name: "Materiales Biológicos para Regeneración de Tejidos (PRP-PRF)", category: "Periodontal", biodental: 100, us: 100 },
  { name: "Gingivectomía o Gingivoplastia", category: "Periodontal", biodental: 300, us: 200 },
  { name: "Dentadura Completa Superior", category: "Dentaduras", biodental: 650, us: 1500 },
  { name: "Dentadura Completa Inferior", category: "Dentaduras", biodental: 650, us: 1500 },
  { name: "Dentadura Inmediata Superior", category: "Dentaduras", biodental: 350, us: 600 },
  { name: "Dentadura Inmediata Inferior", category: "Dentaduras", biodental: 350, us: 600 },
  { name: "Colocación Quirúrgica de Implante Dental", category: "Implantes", biodental: 900, us: 2000 },
  { name: "Pilar de Semi-Precisión", category: "Implantes", biodental: 350, us: 500 },
  { name: "Pilar de Implante", category: "Implantes", biodental: 350, us: 650 },
  { name: "Pilar Personalizado", category: "Implantes", biodental: 400, us: 800 },
  { name: "Corona sobre Implante Porcelana/Cerámica (Emax)", category: "Implantes", biodental: 500, us: 1200 },
  { name: "Corona sobre Implante Porcelana/Cerámica (Zirconia)", category: "Implantes", biodental: 500, us: 1500 },
  { name: "Elevación de Seno Maxilar con Hueso (Abordaje Lateral)", category: "Implantes", biodental: 1300, us: 2500 },
  { name: "Elevación de Seno Maxilar (Abordaje Vertical)", category: "Implantes", biodental: 900, us: 1500 },
  { name: "Extracción Simple Diente Frontal", category: "Extracciones", biodental: 100, us: 200 },
  { name: "Extracción Simple", category: "Extracciones", biodental: 120, us: 200 },
  { name: "Extracciones con Cavitación, Plasma y Ozono", category: "Extracciones", biodental: 350, us: 600 },
  { name: "Extracción de Muela del Juicio", category: "Extracciones", biodental: 150, us: 200 },
  { name: "Extracción de Muela del Juicio Parcialmente Retenida", category: "Extracciones", biodental: 230, us: 240 },
  { name: "Extracción de Muela del Juicio Completamente Retenida", category: "Extracciones", biodental: 300, us: 500 },
  { name: "Guarda Nocturna", category: "Otros", biodental: 120, us: 200 },
  { name: "Carillas", category: "Estética", biodental: 480, us: 1000 },
];

const categories = ["Todos", ...new Set(procedures.map(p => p.category))];
---

<div class="pricing-container">
    <div class="header-section">
        <h1 class="main-title">Odontología Holística a Precios Accesibles en Tijuana, México</h1>
        <p class="subtitle">Ahorra significativamente en procedimientos dentales con calidad de clase mundial<sup>*</sup></p>
    </div>

    <div class="controls-bar">
        <div class="search-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            <input type="text" id="procedureSearch" placeholder="Busca un procedimiento (ej. corona, implante, limpieza)..." />
        </div>

        <div class="category-filters" id="categoryFilters">
            {categories.map((cat, i) => (
                <button class={`filter-pill ${i === 0 ? "active" : ""}`} data-category={cat}>{cat}</button>
            ))}
        </div>
    </div>

    <p class="results-count" id="resultsCount">Mostrando {procedures.length} de {procedures.length} procedimientos</p>

    <div class="pricing-grid" id="pricingGrid">
        {procedures.map((procedure) => {
            const savings = procedure.us - procedure.biodental;
            const message = encodeURIComponent(`¡Hola! Me gustaría agendar una cita para: ${procedure.name}`);
            return (

                <a
                    href={`https://wa.link/nai5wo?text=${message}`}
                    target="_blank"
                    class="pricing-card"
                    data-name={procedure.name.toLowerCase()}
                    data-category={procedure.category}
                >
                    <span class="category-tag">{procedure.category}</span>
                    <h3 class="procedure-name">{procedure.name}</h3>

                    <div class="prices-comparison">
                        <div class="price-block biodental">
                            <span class="price-label">Nuestro Precio</span>
                            <span class="price-value">${procedure.biodental}</span>
                        </div>
                        <div class="vs-divider"><span>vs</span></div>
                        <div class="price-block us">
                            <span class="price-label">Precio USA</span>
                            <span class="price-value">${procedure.us}</span>
                        </div>
                    </div>

                    {savings > 0 ? (
                        <div class="savings-badge">
                            <span>Ahorras ${savings}</span>
                        </div>
                    ) : (
                        <div class="savings-badge neutral">
                            <span>Precio Competitivo</span>
                        </div>
                    )}

                    <span class="book-hint">
                        Agendar este procedimiento
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14M13 6l6 6-6 6"></path>
                        </svg>
                    </span>
                </a>
            );
        })}
    </div>

    <p class="no-results" id="noResults" style="display:none;">No hay procedimientos que coincidan con tu búsqueda. Intenta con otro término o categoría.</p>

    <p class="disclaimer">*Ahorro en comparación con precios promedio en EE. UU.; el ahorro real varía según el procedimiento y el caso.</p>
</div>

<script>
    import "../../scripts/precios.js"
</script>