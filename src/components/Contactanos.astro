---
import MapReveal from './v2/MapReveal.astro'
import '../styles/services-styles/contactanos.css'
import ClinicaImg from '../assets/opt/clinica.webp'
---

<section class="contactanos">
    <div class="contactanos-cont">
        <span class="eyebrow">Get In Touch</span>
        <h1>Leave Us Your <span class="highlight-text">Details</span> and We Will <span class="highlight-text">Contact You</span></h1>

        <div class="contactanos-grid">

            <div class="contacto-izq">
                <MapReveal lang="en" />

                <div class="contact-cards">
                    <a href="tel:+526641942723" class="contact-card">
                        <span class="contact-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                        </span>
                        <div>
                            <span class="contact-label">Call Us</span>
                            <span class="contact-value">(664) 194-2723</span>
                        </div>
                    </a>

                    <a href="mailto:holisticancertreatment@gmail.com" class="contact-card">
                        <span class="contact-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16v16H4z" opacity="0"></path>
                                <path d="M22 6c0-1.1-.9-2-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h16a2 2 0 0 0 2-2V6z"></path>
                                <path d="m22 6-10 7L2 6"></path>
                            </svg>
                        </span>
                        <div>
                            <span class="contact-label">Email Us</span>
                            <span class="contact-value">holisticancertreatment@gmail.com</span>
                        </div>
                    </a>

                    <a href="https://maps.google.com/?q=Tijuana,Baja California,Mexico" target="_blank" class="contact-card">
                        <span class="contact-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </span>
                        <div>
                            <span class="contact-label">Visit Us</span>
                            <span class="contact-value">Tijuana, Baja California, Mexico</span>
                        </div>
                    </a>
                </div>
            </div>

            <div class="hub-form">
                <form name="contact" method="POST" data-netlify="true" id="contactForm">
                    <input type="hidden" name="form-name" value="contact" />

                    <div class="success-message" id="successMessage" style="display: none;">
                        <h3>Thank you for contacting us!</h3>
                        <p>We have received your message and will respond shortly.</p>
                    </div>

                    <div id="formFields">
                        <p class="field-group">
                            <label for="name">Name</label>
                            <input type="text" id="name" name="name" required placeholder="Your full name" />
                        </p>

                        <p class="field-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" required placeholder="you@example.com" />
                        </p>

                        <p class="field-group">
                            <label for="phone">Phone</label>
                            <input type="tel" id="phone" name="phone" placeholder="(optional)" />
                        </p>

                        <p class="field-group">
                            <label for="message">Message</label>
                            <textarea id="message" name="message" required placeholder="How can we help you?"></textarea>
                        </p>

                        <p>
                            <button type="submit">
                                Request a Consultation
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                                </svg>
                            </button>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    import "../scripts/formulario"
</script>