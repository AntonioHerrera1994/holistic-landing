---
/**
 * Servicios interactivos: al seleccionar un servicio, el lienzo "dibuja"
 * una ilustración de línea relacionada (stroke-dashoffset + pathLength).
 * Auto-avanza cuando está en pantalla hasta que el usuario interactúa.
 * Accesible: tablist con flechas del teclado.
 */
import { services, home, type Lang } from '../../i18n/content';
import MotionArt from './MotionArt.astro';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = home[lang];

---

<section class="svx" id="servicios" data-svx>
  <div class="svx-head" data-reveal>
    <span class="eyebrow-v2">{t.svcEyebrow}</span>
    <h2 class="h-display">{t.svcTitle[0]}<br /><em>{t.svcTitle[1]}</em></h2>
  </div>

  <div class="svx-grid">
    <div class="svx-list" role="tablist" aria-label={t.svcHint} data-reveal style="--d:80ms">
      {services.map((s, i) => (
        <button
          class:list={['svx-item', { active: i === 0 }]}
          role="tab"
          id={`svx-tab-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls="svx-panel"
          tabindex={i === 0 ? 0 : -1}
          data-id={s.id}
        >
          <span class="svx-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="svx-title">{s.title[lang]}</span>
          <svg class="svx-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          <span class="svx-progress" aria-hidden="true"></span>
        </button>
      ))}
    </div>

    <div class="svx-stage" data-reveal style="--d:160ms">
      <div class="svx-canvas" aria-hidden="true">
        <span class="svx-blob"></span>
        <div class="svx-svg">
          {services.map((s, i) => (
            <MotionArt kind={s.id} active={i === 0} class="draw" />
          ))}
        </div>
        <span class="svx-count"><b id="svxIdx">01</b> / {String(services.length).padStart(2, '0')}</span>
      </div>

      <div class="svx-panel" id="svx-panel" role="tabpanel" aria-live="polite">
        {services.map((s, i) => (
          <div class:list={['svx-copy', { on: i === 0 }]} data-id={s.id} hidden={i !== 0}>
            <h3>{s.title[lang]}</h3>
            <p>{s.text[lang]}</p>
            <div class="svx-tags">{s.tags[lang].map((tg) => <span>{tg}</span>)}</div>
            <a href={s.href[lang]} class="link-arrow">{t.svcMore}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .svx {
    padding: clamp(80px, 11vw, 150px) var(--pad-x);
    background: var(--paper);
    font-family: var(--font-body);
  }
  .svx-head { max-width: 1320px; margin: 0 auto 56px; display: grid; gap: 18px; }
  .svx-head .h-display { font-size: clamp(40px, 5.6vw, 78px); }

  .svx-grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }

  /* ---- Lista ---- */
  .svx-list { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .svx-item {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 22px 6px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    text-align: left;
    cursor: pointer;
    color: var(--ink-3);
    font: inherit;
    transition: color 0.35s var(--ease), padding 0.35s var(--ease);
  }
  .svx-num { font: 600 12px/1 var(--font-body); letter-spacing: 0.08em; }
  .svx-title { font: 400 clamp(20px, 2vw, 27px)/1.15 var(--font-display); letter-spacing: -0.01em; }
  .svx-arrow { opacity: 0; transform: translateX(-8px); transition: all 0.35s var(--ease); color: var(--brand); }
  .svx-item:hover { color: var(--ink); }
  .svx-item.active { color: var(--ink); padding-left: 14px; }
  .svx-item.active .svx-num { color: var(--brand); }
  .svx-item.active .svx-arrow { opacity: 1; transform: none; }
  .svx-item:focus-visible { outline: 2px solid var(--brand); outline-offset: -2px; border-radius: 8px; }
  .svx-progress {
    position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%;
    background: var(--brand);
    transform: scaleX(0); transform-origin: left;
  }
  .svx[data-auto='true'] .svx-item.active .svx-progress { animation: svxProg var(--svx-dur, 5600ms) linear forwards; }
  @keyframes svxProg { to { transform: scaleX(1); } }

  /* ---- Lienzo ---- */
  .svx-stage { position: sticky; top: 110px; display: grid; gap: 22px; }
  .svx-canvas {
    position: relative;
    aspect-ratio: 1 / 0.86;
    border-radius: var(--radius);
    background-color: #fff;
    background-image: radial-gradient(rgba(9, 30, 61, 0.09) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    border: 1px solid var(--line);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .svx-blob {
    position: absolute;
    width: 62%; aspect-ratio: 1;
    background: var(--brand-soft);
    border-radius: 46% 54% 58% 42% / 44% 46% 54% 56%;
    animation: blob 14s ease-in-out infinite;
  }
  .svx-canvas.pulse .svx-blob { animation: blob 14s ease-in-out infinite, pop 0.9s var(--ease); }
  @keyframes blob {
    50% { border-radius: 58% 42% 44% 56% / 52% 58% 42% 48%; transform: rotate(14deg); }
  }
  @keyframes pop { 0% { scale: 0.86; } 100% { scale: 1; } }

  .svx-svg { position: relative; width: 74%; }
  .svx-svg :global(.draw) { display: none; }
  .svx-svg :global(.draw.on) { display: block; }

  .svx-count {
    position: absolute; right: 22px; bottom: 18px;
    font: 500 13px/1 var(--font-body); color: var(--ink-3); letter-spacing: 0.06em;
  }
  .svx-count b { color: var(--ink); font-weight: 700; }

  /* ---- Texto ---- */
  .svx-copy h3 { font: 400 clamp(26px, 2.6vw, 34px)/1.1 var(--font-display); color: var(--ink); margin: 0 0 10px; }
  .svx-copy p { color: var(--ink-2); font-size: 16.5px; line-height: 1.65; margin: 0 0 16px; max-width: 58ch; }
  .svx-copy.on { animation: copyIn 0.6s var(--ease) both; }
  @keyframes copyIn { from { opacity: 0; transform: translateY(10px); } }
  .svx-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .svx-tags span {
    font-size: 13px; font-weight: 600; color: var(--ink);
    padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff;
  }

  @media (max-width: 900px) {
    .svx-grid { grid-template-columns: 1fr; }
    .svx-stage { position: static; }
    .svx-list { order: -1; margin: 0 calc(var(--pad-x) * -1); padding: 0 var(--pad-x) 4px !important; flex-direction: row; overflow-x: auto; gap: 8px; border: 0; scrollbar-width: none; padding-bottom: 4px; }
    .svx-list::-webkit-scrollbar { display: none; }
    .svx-item {
      flex: 0 0 auto; grid-template-columns: auto auto; padding: 12px 16px;
      border: 1px solid var(--line); border-radius: 999px; background: #fff;
    }
    .svx-item.active { padding-left: 16px; background: var(--brand); color: #fff; border-color: var(--brand); }
    .svx-item.active .svx-num { color: #fff; }
    .svx-title { font: 600 14px/1 var(--font-body); }
    .svx-arrow, .svx-progress { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-svx]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.svx-item'));
    const draws = Array.from(root.querySelectorAll<SVGSVGElement>('.svx-svg .draw'));
    const copies = Array.from(root.querySelectorAll<HTMLElement>('.svx-copy'));
    const canvas = root.querySelector<HTMLElement>('.svx-canvas');
    const idx = root.querySelector<HTMLElement>('#svxIdx');
    const DUR = 5600;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;
    let auto = !reduce;
    let visible = false;

    const select = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      const id = tabs[current].dataset.id;
      tabs.forEach((t, n) => {
        const on = n === current;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      draws.forEach((g) => {
        g.classList.remove('on');
        if (g.dataset.kind === id) { void g.getBoundingClientRect(); g.classList.add('on'); }
      });
      copies.forEach((c) => { const on = c.dataset.id === id; c.hidden = !on; c.classList.toggle('on', on); });
      if (canvas) { canvas.classList.remove('pulse'); void canvas.offsetWidth; canvas.classList.add('pulse'); }
      if (idx) idx.textContent = String(current + 1).padStart(2, '0');
      if (focus) tabs[current].focus();
      if (window.innerWidth <= 900) tabs[current].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      schedule();
    };

    const schedule = () => {
      window.clearTimeout(timer);
      root.dataset.auto = String(auto && visible);
      root.style.setProperty('--svx-dur', DUR + 'ms');
      if (auto && visible) timer = window.setTimeout(() => select(current + 1), DUR);
    };

    const stopAuto = () => { auto = false; schedule(); };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stopAuto(); select(i); });
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); stopAuto(); select(current + 1, true); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); stopAuto(); select(current - 1, true); }
      });
    });

    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      schedule();
    }, { threshold: 0.35 }).observe(root);
  });
</script>
