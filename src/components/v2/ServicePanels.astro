---
/**
 * Servicios — paneles expandibles con fotografía (opción A).
 * Desktop: paneles verticales en fila; el seleccionado se expande y muestra el detalle.
 * Móvil/tablet (<900px): acordeón vertical.
 * Fotos: Unsplash (licencia Unsplash, uso comercial libre) en src/assets/servicios/.
 */
import { services, home, type Lang } from '../../i18n/content';
import Plan from '../../assets/servicios/plan.webp';
import Heat from '../../assets/servicios/heat.webp';
import Leaf from '../../assets/servicios/leaf.webp';
import Heart from '../../assets/servicios/heart.webp';
import Tooth from '../../assets/servicios/tooth.webp';
import Cells from '../../assets/servicios/cells.webp';
import Candle from '../../assets/servicios/candle.webp';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = home[lang];
const photos: Record<string, ImageMetadata> = { plan: Plan, heat: Heat, leaf: Leaf, heart: Heart, tooth: Tooth, cells: Cells, candle: Candle };
const alts: Record<string, { en: string; es: string }> = {
  plan: { en: 'Doctor reviewing a care plan with a patient', es: 'Médica revisando un plan de atención con un paciente' },
  heat: { en: 'Warm wooden heat-therapy room', es: 'Sala de terapia de calor en madera' },
  leaf: { en: 'Fresh vegetable salad for nutritional support', es: 'Ensalada de vegetales frescos para apoyo nutricional' },
  heart: { en: 'Physical therapist guiding a patient on parallel bars', es: 'Terapeuta guiando a una paciente en barras paralelas' },
  tooth: { en: 'Dentist examining a patient', es: 'Dentista revisando a una paciente' },
  cells: { en: 'Laboratory specialist placing a sample under a microscope', es: 'Especialista de laboratorio colocando una muestra en el microscopio' },
  candle: { en: 'Hands holding a patient’s hand in comfort', es: 'Manos sosteniendo la mano de un paciente' },
};
const head = lang === 'es'
  ? { title: ['Conoce nuestros', 'servicios.'], hint: 'Selecciona un servicio para ver el detalle' }
  : { title: ['Explore our', 'services.'], hint: 'Select a service to see the details' };
const arrow = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>`;
---

<section class="sp" id="servicios" data-sp>
  <div class="sp-head" data-reveal>
    <div>
      <span class="eyebrow-v2">{t.svcEyebrow}</span>
      <h2 class="h-display">{head.title[0]}{' '}<em>{head.title[1]}</em></h2>
    </div>
    <p class="sp-hint">
      <span class="sp-hint-dot" aria-hidden="true"></span>{head.hint}
    </p>
  </div>

  <div class="sp-row" data-reveal style="--d:120ms">
    {services.map((s, i) => (
      <article class:list={['sp-panel', { on: i === 0 }]} data-i={i}>
        <img src={photos[s.id].src} alt={alts[s.id][lang]} loading={i < 2 ? 'eager' : 'lazy'} width="1100" height="1650" />
        <span class="sp-shade" aria-hidden="true"></span>

        <button class="sp-trigger" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`sp-body-${lang}-${s.id}`}>
          <span class="sp-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="sp-label">{s.title[lang]}</span>
          <span class="sp-plus" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
          </span>
        </button>

        <div class="sp-body" id={`sp-body-${lang}-${s.id}`}>
          <h3>{s.title[lang]}</h3>
          <p>{s.text[lang]}</p>
          <div class="sp-tags">{s.tags[lang].map((tg) => <span>{tg}</span>)}</div>
          <a href={s.href[lang]} class="btn sp-cta" tabindex={i === 0 ? 0 : -1}>{t.svcMore}<span class="sr-only"> — {s.title[lang]}</span><Fragment set:html={arrow} /></a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .sp { background: var(--paper); padding: clamp(80px, 10vw, 140px) var(--pad-x); font-family: var(--font-body); }
  .sp-head { max-width: 1320px; margin: 0 auto 44px; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .sp-head > div { display: grid; gap: 16px; }
  .sp-head .h-display { font-size: clamp(40px, 5.4vw, 74px); }
  .sp-hint { display: inline-flex; align-items: center; gap: 10px; margin: 0; font: 600 14px/1.3 var(--font-display); color: var(--ink-2); }
  .sp-hint-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 0 rgba(10,122,128,.5); animation: spPulse 2s ease-out infinite; }
  @keyframes spPulse { to { box-shadow: 0 0 0 12px rgba(10,122,128,0); } }

  /* ---------- fila de paneles ---------- */
  .sp-row { max-width: 1320px; margin: 0 auto; display: flex; gap: 10px; height: clamp(480px, 62vh, 620px); }
  .sp-panel {
    position: relative; flex: 1 1 0; min-width: 68px; overflow: hidden; border-radius: 22px; background: var(--ink); color: #fff;
    transition: flex-grow .8s cubic-bezier(.22,1,.36,1);
  }
  .sp-panel.on { flex-grow: 5.2; }
  .sp-panel img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transform: scale(1.08); filter: saturate(.85);
    transition: transform 1.2s cubic-bezier(.22,1,.36,1), filter .6s ease;
  }
  .sp-panel.on img { transform: scale(1); filter: none; }
  .sp-panel:not(.on):hover img { transform: scale(1.12); }
  .sp-shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(9,30,61,.92) 0%, rgba(9,30,61,.45) 45%, rgba(9,30,61,.25) 100%); transition: background .6s ease; }
  .sp-panel:not(.on) .sp-shade { background: rgba(9,30,61,.62); }
  .sp-panel:not(.on):hover .sp-shade { background: rgba(9,30,61,.48); }

  /* disparador: cubre todo el panel cerrado */
  .sp-trigger {
    position: absolute; inset: 0; z-index: 2; border: 0; background: transparent; color: #fff; cursor: pointer; padding: 0;
    font: inherit; text-align: left;
  }
  .sp-trigger:focus-visible { outline: 3px solid #7fd3d8; outline-offset: -6px; border-radius: 22px; }
  .sp-num { position: absolute; top: 64px; left: 50%; transform: translateX(-50%); font: 700 13px/1 var(--font-display); letter-spacing: .08em; opacity: .85; }
  .sp-plus {
    position: absolute; top: 14px; left: 50%; margin-left: -17px; width: 34px; height: 34px; border-radius: 50%; background: #fff; color: var(--ink);
    display: grid; place-items: center; transition: transform .4s ease, opacity .3s ease;
  }
  .sp-label {
    position: absolute; left: 50%; bottom: 24px; transform: translateX(-50%) rotate(180deg);
    writing-mode: vertical-rl; white-space: nowrap; font: 500 20px/1 var(--font-display); letter-spacing: .01em;
    transition: opacity .35s ease;
  }
  .sp-panel.on .sp-trigger { pointer-events: none; }
  .sp-panel.on .sp-label, .sp-panel.on .sp-plus { opacity: 0; }
  .sp-panel.on .sp-num { top: 22px; left: 24px; transform: none; }

  /* detalle del panel abierto */
  .sp-body {
    position: absolute; z-index: 3; left: 0; right: 0; bottom: 0; padding: clamp(22px, 3vw, 40px);
    display: grid; gap: 14px; max-width: 620px;
    opacity: 0; transform: translateY(20px); pointer-events: none;
    transition: opacity .4s ease, transform .5s cubic-bezier(.22,1,.36,1);
  }
  .sp-panel.on .sp-body { opacity: 1; transform: none; pointer-events: auto; transition-delay: .35s; }
  .sp-body h3 { margin: 0; font: 500 clamp(26px, 2.6vw, 38px)/1.1 var(--font-display); letter-spacing: -.01em; }
  .sp-body p { margin: 0; color: rgba(255,255,255,.82); font-size: 16px; line-height: 1.65; }
  .sp-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .sp-tags span { font: 600 12.5px/1 var(--font-display); padding: 9px 13px; border-radius: 999px; border: 1px solid rgba(255,255,255,.35); background: rgba(255,255,255,.08); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .sp-cta { justify-self: start; margin-top: 4px; }

  /* ---------- tablet / móvil: acordeón vertical ---------- */
  @media (max-width: 900px) {
    .sp-row { flex-direction: column; height: auto; gap: 8px; }
    .sp-panel { flex: none; min-width: 0; height: 76px; transition: height .7s cubic-bezier(.22,1,.36,1); border-radius: 18px; }
    .sp-panel.on { height: min(520px, 118vw); }
    .sp-label { writing-mode: horizontal-tb; transform: translateY(-50%); left: 60px; top: 50%; bottom: auto; font-size: 18px; max-width: calc(100% - 120px); overflow: hidden; text-overflow: ellipsis; }
    .sp-num { top: 50%; transform: translateY(-50%); left: 20px; }
    .sp-panel.on .sp-num { top: 20px; left: 20px; transform: none; }
    .sp-plus { top: 50%; transform: translateY(-50%); left: auto; right: 18px; margin-left: 0; }
    .sp-panel.on .sp-plus { transform: translateY(-50%) rotate(45deg); }
    .sp-body { max-width: none; }
    .sp-body p { font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sp-panel, .sp-panel img, .sp-body { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-sp]').forEach((root) => {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.sp-panel'));
    const open = (n: number, focus = false) => {
      panels.forEach((p, i) => {
        const on = i === n;
        p.classList.toggle('on', on);
        p.querySelector('.sp-trigger')?.setAttribute('aria-expanded', String(on));
        p.querySelectorAll<HTMLElement>('.sp-body a').forEach((a) => (a.tabIndex = on ? 0 : -1));
      });
      if (focus) panels[n].querySelector<HTMLElement>('.sp-cta')?.focus({ preventScroll: true });
      // en móvil, lleva el panel abierto a la vista
      if (window.innerWidth <= 900) {
        window.setTimeout(() => {
          const r = panels[n].getBoundingClientRect();
          if (r.top < 90 || r.bottom > window.innerHeight) window.scrollBy({ top: r.top - 100, behavior: 'smooth' });
        }, 350);
      }
    };
    panels.forEach((p, i) => {
      const trg = p.querySelector<HTMLButtonElement>('.sp-trigger');
      trg?.addEventListener('click', () => open(i));
      p.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); const n = (i + 1) % panels.length; open(n); panels[n].querySelector<HTMLElement>('.sp-cta')?.focus(); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); const n = (i - 1 + panels.length) % panels.length; open(n); panels[n].querySelector<HTMLElement>('.sp-cta')?.focus(); }
      });
    });
  });
</script>
