---
/**
 * "Nuestros expertos" — slider con flechas + dots.
 * Cada slide presenta a un experto y el servicio que ofrece.
 * Para agregar otro experto: añade un item en home[lang].experts.items (i18n/content.ts)
 * y su foto en el mapa `photos` de abajo.
 */
import Gloria from '../../assets/opt/gloria.webp';
import Dentist from '../../assets/opt/equipo1.webp';
import { home, type Lang } from '../../i18n/content';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = home[lang].experts;
const photos: Record<string, ImageMetadata> = { gloria: Gloria, dentist: Dentist };
const arrow = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
const total = String(t.items.length).padStart(2, '0');
---

<section class="ex" data-ex aria-roledescription="carousel" aria-label={t.eyebrow}>
  <div class="ex-top">
    <div class="ex-head" data-reveal>
      <span class="eyebrow-v2 on-dark">{t.eyebrow}</span>
      <h2 class="h-display">{t.title[0]}{' '}<em>{t.title[1]}</em></h2>
    </div>
    <div class="ex-nav" data-reveal style="--d:120ms">
      <span class="ex-count"><b data-ex-idx>01</b> / {total}</span>
      <button class="ex-arrow" data-ex-prev aria-label={t.prev}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      </button>
      <button class="ex-arrow" data-ex-next aria-label={t.next}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>
    </div>
  </div>

  <div class="ex-viewport" data-reveal style="--d:160ms">
    {t.items.map((it, i) => (
      <article class:list={['ex-slide', { on: i === 0 }]} role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${t.items.length}: ${it.name}`} aria-hidden={i === 0 ? 'false' : 'true'}>
        <div class="ex-photo">
          <img src={photos[it.img].src} alt={it.name} loading={i === 0 ? 'eager' : 'lazy'} width="560" height="620" />
          <span class="ex-tag">{it.tag}</span>
        </div>
        <div class="ex-copy">
          <div class="ex-who">
            <strong>{it.name}</strong>
            <span>{it.service}</span>
          </div>
          <h3 class="h-display">{it.title[0]}{' '}<em>{it.title[1]}</em></h3>
          <p>{it.text}</p>
          <ul class="ex-chips">{it.chips.map((c) => <li>{c}</li>)}</ul>
          <div><a href={it.href} class="btn" tabindex={i === 0 ? 0 : -1}>{it.cta}<Fragment set:html={arrow} /></a></div>
          {it.fine && <small class="ex-fine">{it.fine}</small>}
        </div>
      </article>
    ))}
  </div>

  <div class="ex-dots" role="tablist">
    {t.items.map((it, i) => (
      <button class:list={['ex-dot', { on: i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={it.name} data-i={i}>
        <span>{it.service}</span>
      </button>
    ))}
  </div>
</section>

<style>
  .ex { background: var(--ink); color: #fff; padding: clamp(80px, 10vw, 140px) var(--pad-x); font-family: var(--font-body); overflow: hidden; }
  .ex-top { max-width: 1240px; margin: 0 auto 48px; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .ex-head { display: grid; gap: 16px; }
  .ex .eyebrow-v2.on-dark { color: #7fd3d8; }
  .ex .h-display { color: #fff; }
  .ex .h-display em { color: #7fd3d8; }
  .ex-head .h-display { font-size: clamp(36px, 4.6vw, 64px); }

  .ex-nav { display: flex; align-items: center; gap: 12px; }
  .ex-count { font: 600 14px/1 var(--font-display); color: rgba(255,255,255,.55); margin-right: 8px; letter-spacing: .08em; }
  .ex-count b { color: #fff; }
  .ex-arrow {
    width: 56px; height: 56px; border-radius: 50%; cursor: pointer;
    border: 1px solid rgba(255,255,255,.25); background: transparent; color: #fff;
    display: grid; place-items: center;
    transition: background-color .3s var(--ease), border-color .3s var(--ease), transform .3s var(--ease);
  }
  .ex-arrow:hover { background: var(--brand); border-color: var(--brand); }
  .ex-arrow:active { transform: scale(.94); }
  .ex-arrow:focus-visible { outline: 2px solid #7fd3d8; outline-offset: 3px; }

  .ex-viewport { max-width: 1240px; margin: 0 auto; display: grid; }
  .ex-slide {
    grid-area: 1 / 1;
    display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(32px, 6vw, 96px); align-items: center;
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity .7s var(--ease), visibility 0s linear .7s;
  }
  .ex-slide.on { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity .7s var(--ease), visibility 0s; }

  .ex-photo { position: relative; }
  .ex-photo img {
    width: 100%; aspect-ratio: .9; object-fit: cover; object-position: top; display: block; background: #e9e9e9;
    border-radius: 999px 999px var(--radius) var(--radius);
    clip-path: inset(100% 0 0 0 round 999px 999px 28px 28px);
    transition: clip-path 1.1s var(--ease);
  }
  .ex-slide.on .ex-photo img { clip-path: inset(0 0 0 0 round 999px 999px 28px 28px); }
  .ex-tag {
    position: absolute; left: 50%; bottom: -16px; transform: translateX(-50%);
    background: var(--brand); color: #fff; font: 700 13px/1 var(--font-display); letter-spacing: .06em;
    padding: 13px 18px; border-radius: 999px; white-space: nowrap;
  }

  .ex-copy { display: grid; gap: 22px; }
  .ex-copy > * { opacity: 0; transform: translateY(18px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
  .ex-slide.on .ex-copy > * { opacity: 1; transform: none; }
  .ex-slide.on .ex-copy > *:nth-child(2) { transition-delay: .08s; }
  .ex-slide.on .ex-copy > *:nth-child(3) { transition-delay: .16s; }
  .ex-slide.on .ex-copy > *:nth-child(4) { transition-delay: .24s; }
  .ex-slide.on .ex-copy > *:nth-child(5) { transition-delay: .32s; }
  .ex-slide.on .ex-copy > *:nth-child(6) { transition-delay: .4s; }
  .ex-who { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .ex-who strong { font: 600 18px/1.2 var(--font-display); }
  .ex-who span { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #7fd3d8; font-weight: 600; }
  .ex-copy .h-display { font-size: clamp(32px, 3.8vw, 56px); }
  .ex-copy p { margin: 0; color: rgba(255,255,255,.75); font-size: 17px; line-height: 1.7; max-width: 56ch; }
  .ex-chips { display: flex; flex-wrap: wrap; gap: 10px; padding: 0; margin: 0; list-style: none; }
  .ex-chips li { border: 1px solid rgba(255,255,255,.22); padding: 10px 16px; border-radius: 999px; font: 600 14px/1 var(--font-display); }
  .ex-fine { color: rgba(255,255,255,.5); font-size: 12.5px; line-height: 1.5; max-width: 62ch; }

  .ex-dots { max-width: 1240px; margin: 56px auto 0; display: flex; gap: 10px; }
  .ex-dot {
    position: relative; flex: 0 0 auto; height: 42px; padding: 0 18px; border-radius: 999px; cursor: pointer;
    border: 1px solid rgba(255,255,255,.2); background: transparent; color: rgba(255,255,255,.6);
    font: 600 13px/1 var(--font-display); letter-spacing: .04em; overflow: hidden;
    transition: color .3s var(--ease), border-color .3s var(--ease);
  }
  .ex-dot::before {
    content: ''; position: absolute; inset: 0; background: var(--brand);
    transform: scaleX(0); transform-origin: left;
  }
  .ex-dot span { position: relative; }
  .ex-dot.on { color: #fff; border-color: var(--brand); }
  .ex[data-auto='true'] .ex-dot.on::before { animation: exProg var(--ex-dur, 7000ms) linear forwards; }
  .ex[data-auto='false'] .ex-dot.on::before { transform: scaleX(1); }
  @keyframes exProg { to { transform: scaleX(1); } }

  @media (max-width: 900px) {
    .ex-slide { grid-template-columns: 1fr; }
    .ex-photo { max-width: 280px; width: 78%; margin: 0 auto 10px; }
    .ex-dots { overflow-x: auto; scrollbar-width: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ex]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.ex-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.ex-dot'));
    const idx = root.querySelector<HTMLElement>('[data-ex-idx]');
    const DUR = 7000;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, timer: number | undefined, auto = !reduce && slides.length > 1, visible = false;

    const go = (i: number) => {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        const on = n === cur;
        s.classList.toggle('on', on);
        s.setAttribute('aria-hidden', String(!on));
        s.querySelectorAll<HTMLElement>('a').forEach((a) => (a.tabIndex = on ? 0 : -1));
      });
      dots.forEach((d, n) => { d.classList.toggle('on', n === cur); d.setAttribute('aria-selected', String(n === cur)); });
      if (idx) idx.textContent = String(cur + 1).padStart(2, '0');
      schedule();
    };
    const schedule = () => {
      window.clearTimeout(timer);
      root.dataset.auto = String(auto && visible);
      root.style.setProperty('--ex-dur', DUR + 'ms');
      if (auto && visible) timer = window.setTimeout(() => go(cur + 1), DUR);
    };
    const manual = (i: number) => { auto = false; go(i); };

    root.querySelector('[data-ex-prev]')?.addEventListener('click', () => manual(cur - 1));
    root.querySelector('[data-ex-next]')?.addEventListener('click', () => manual(cur + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => manual(i)));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') manual(cur + 1);
      if (e.key === 'ArrowLeft') manual(cur - 1);
    });
    // swipe en móvil
    let x0: number | null = null;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) manual(cur + (dx < 0 ? 1 : -1));
      x0 = null;
    });
    root.addEventListener('mouseenter', () => { window.clearTimeout(timer); root.dataset.auto = 'false'; });
    root.addEventListener('mouseleave', schedule);
    new IntersectionObserver((en) => { visible = en[0].isIntersecting; schedule(); }, { threshold: 0.3 }).observe(root);
    go(0);
  });
</script>
