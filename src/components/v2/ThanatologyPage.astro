---
/**
 * Tanatología con Gloria — página dedicada (ES /tanatologia, EN /thanatology).
 * REVISAR (legal): antes de publicar "Especialista", confirmar el diploma/certificación
 * en tanatología de Gloria (y cédula si aplica). Si no hay documento, cambiar el H1 a
 * "Acompañamiento tanatológico a pacientes en etapa terminal".
 */
import Gloria from '../../assets/opt/gloria.webp';
import { thanatology, type Lang } from '../../i18n/content';
import { WHATSAPP, PHONE_DISPLAY, PHONE_TEL } from '../../i18n/routes';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = thanatology[lang];
const arrow = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

const icons = [
  // diagnóstico: burbuja de diálogo
  '<path d="M4 5h16v11H9l-5 4z"/>',
  // duelo anticipado: hoja cayendo
  '<path d="M12 3C8 7 6 10 6 13a6 6 0 0 0 12 0c0-3-2-6-6-10z"/><path d="M12 9v12"/>',
  // pendientes: lista
  '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2"/>',
  // familia: dos personas
  '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M15 20c0-2 1-4 3-4.6"/>',
  // duelo: vela
  '<path d="M10 21V11h4v10"/><path d="M12 8c-1.5-1.5-1-3.5 0-5 1 1.5 1.5 3.5 0 5z"/>',
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="th-hero">
  <div class="th-hero-copy">
    <span class="th-lockup" data-in>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8c-1.5-1.5-1-3.5 0-5 1 1.5 1.5 3.5 0 5z"/><path d="M10 21V11h4v10"/></svg>
      {t.lockup}
    </span>
    <span class="eyebrow-v2" data-in style="--d:60ms">{t.eyebrow}</span>
    <h1 class="h-display" data-in style="--d:120ms">{`${t.h1[0]} ${t.h1[1]} `}<em>{t.h1[2]}</em></h1>
    <p class="th-lead" data-in style="--d:200ms">{t.lead}</p>
    <div class="th-actions" data-in style="--d:260ms">
      <a href={WHATSAPP} target="_blank" rel="noopener" class="btn">{t.cta}<Fragment set:html={arrow} /></a>
      <a href="#como-funciona" class="link-arrow">{t.cta2}</a>
    </div>
  </div>
  <div class="th-hero-visual">
    <div class="th-photo"><img src={Gloria.src} alt="Gloria Alejo" width="560" height="640" fetchpriority="high" /></div>
    <svg class="th-halo" viewBox="0 0 400 400" aria-hidden="true">
      <circle cx="200" cy="200" r="190" pathLength="1" />
      <circle cx="200" cy="200" r="160" pathLength="1" />
    </svg>
    <span class="th-float"><i class="bi bi-camera-video"></i>{t.floating}</span>
  </div>
</section>

<section class="th-modes">
  <div class="th-head" data-reveal>
    <span class="eyebrow-v2">{t.modesEyebrow}</span>
    <h2 class="h-display">{t.modesTitle[0]}{' '}<em>{t.modesTitle[1]}</em></h2>
  </div>
  <div class="th-modes-grid">
    {t.modes.map((m, i) => (
      <article class:list={['mode', { dark: i === 0 }]} data-reveal style={`--d:${i * 90}ms`}>
        <span class="mode-icon" aria-hidden="true">
          {i === 0
            ? <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="m16 10 6-3v10l-6-3"/></svg>
            : <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>}
        </span>
        <span class="mode-k">{m.k}</span>
        <h3>{m.t}</h3>
        <p>{m.p}</p>
        <ul>{m.items.map((it) => <li>{it}</li>)}</ul>
      </article>
    ))}
  </div>
</section>

<section class="th-help">
  <div class="th-head" data-reveal>
    <span class="eyebrow-v2">{t.helpEyebrow}</span>
    <h2 class="h-display">{t.helpTitle[0]}{' '}<em>{t.helpTitle[1]}</em></h2>
  </div>
  <ol class="th-help-list">
    {t.help.map((h, i) => (
      <li data-reveal style={`--d:${i * 60}ms`}>
        <span class="hl-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
        </span>
        <h3>{h.t}</h3>
        <p>{h.p}</p>
      </li>
    ))}
    <li class="hl-cta" data-reveal style="--d:300ms">
      <h3>{lang === 'es' ? '¿No sabes por dónde empezar?' : 'Not sure where to start?'}</h3>
      <p>{lang === 'es' ? 'Escríbenos y te orientamos sin compromiso.' : 'Message us and we will guide you, no commitment.'}</p>
      <a href={WHATSAPP} target="_blank" rel="noopener" class="link-arrow">WhatsApp</a>
    </li>
  </ol>
</section>

<section class="th-steps" id="como-funciona">
  <div class="th-head" data-reveal><span class="eyebrow-v2">{t.stepsEyebrow}</span></div>
  <div class="steps">
    <svg class="steps-line" viewBox="0 0 1000 20" preserveAspectRatio="none" aria-hidden="true"><path d="M0 10 L1000 10" pathLength="1" /></svg>
    {t.steps.map((s, i) => (
      <div class="step" data-reveal style={`--d:${i * 140}ms`}>
        <span class="step-k">{s.k}</span>
        <h3>{s.t}</h3>
        <p>{s.p}</p>
      </div>
    ))}
  </div>
</section>

<section class="th-about">
  <div class="th-about-inner">
    <div class="th-about-card" data-reveal>
      <img src={Gloria.src} alt="" loading="lazy" />
      <div>
        <strong>{t.aboutName}</strong>
        <span>{t.aboutRole}</span>
      </div>
    </div>
    <div class="th-about-copy">
      <span class="eyebrow-v2 on-dark" data-reveal>{t.aboutEyebrow}</span>
      {t.aboutText.map((p, i) => <p data-reveal style={`--d:${80 + i * 80}ms`}>{p}</p>)}
    </div>
  </div>
</section>

<section class="th-faq">
  <div class="th-faq-inner">
    <div class="th-head" data-reveal><span class="eyebrow-v2">{t.faqEyebrow}</span></div>
    <div class="faq-list">
      {t.faq.map((f, i) => (
        <details data-reveal style={`--d:${i * 60}ms`} open={i === 0}>
          <summary>{f.q}<span aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="th-crisis" role="note">
      <i class="bi bi-telephone"></i>{t.crisis}
    </p>
  </div>
</section>

<section class="th-close">
  <h2 class="h-display" data-reveal>{t.closing[0]}<br /><em>{t.closing[1]}</em></h2>
  <p data-reveal style="--d:80ms">{t.closingText}</p>
  <div class="th-close-actions" data-reveal style="--d:140ms">
    <a href={WHATSAPP} target="_blank" rel="noopener" class="btn"><i class="bi bi-whatsapp"></i>{t.cta}</a>
    <a href={PHONE_TEL} class="link-arrow">{PHONE_DISPLAY}</a>
  </div>
  <p class="th-disc">{t.disclaimer}</p>
</section>

<style>
  .th-hero, .th-modes, .th-help, .th-steps, .th-about, .th-faq, .th-close { font-family: var(--font-body); padding-left: var(--pad-x); padding-right: var(--pad-x); }
  .th-head { max-width: 1240px; margin: 0 auto 44px; display: grid; gap: 16px; }
  .th-head .h-display { font-size: clamp(36px, 4.8vw, 66px); }

  /* Hero */
  .th-hero {
    background: var(--cream);
    padding-top: 150px; padding-bottom: 90px;
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(30px, 6vw, 90px); align-items: center;
    min-height: 92svh; box-sizing: border-box;
  }
  .th-hero-copy { display: grid; gap: 22px; max-width: 700px; }
  [data-in] { animation: thIn .9s var(--ease) both; animation-delay: var(--d, 0ms); }
  .th-hero-visual { animation: thIn 1.1s var(--ease) both; }
  @keyframes thIn { from { transform: translateY(22px); } }
  .th-lockup {
    display: inline-flex; align-items: center; gap: 10px; width: fit-content;
    font: 500 22px/1 var(--font-display);  color: var(--ink);
    padding: 10px 16px 10px 12px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line);
  }
  .th-lockup svg { color: var(--brand); }
  .th-hero .h-display { font-size: clamp(40px, 5.6vw, 84px); }
  .th-lead { margin: 0; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.7; color: var(--ink-2); max-width: 56ch; }
  .th-actions { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; color: var(--ink); }

  .th-hero-visual { position: relative; justify-self: center; width: min(100%, 480px); aspect-ratio: 1; display: grid; place-items: center; }
  .th-photo { width: 80%; aspect-ratio: 0.86; border-radius: 999px 999px var(--radius) var(--radius); overflow: hidden; background: #e8e8e8; position: relative; z-index: 1; }
  .th-photo img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .th-halo { position: absolute; inset: 0; width: 100%; height: 100%; }
  .th-halo circle { fill: none; stroke: var(--brand); stroke-width: 1.2; stroke-dasharray: 1; stroke-dashoffset: 1; animation: halo 2.6s var(--ease) .4s forwards; }
  .th-halo circle + circle { stroke: var(--line); animation-delay: .7s; }
  @keyframes halo { to { stroke-dashoffset: 0; } }
  .th-float {
    position: absolute; z-index: 2; bottom: 6%; right: 0;
    display: inline-flex; gap: 10px; align-items: center;
    background: var(--brand); color: #fff; font-weight: 700; font-size: 14px;
    padding: 13px 18px; border-radius: 999px; box-shadow: 0 16px 30px -14px rgba(9,30,61,.5);
    animation: bob 4s ease-in-out infinite;
  }
  @keyframes bob { 50% { transform: translateY(-8px); } }

  /* Modalidades */
  .th-modes { background: var(--paper); padding-top: clamp(80px, 10vw, 140px); padding-bottom: clamp(80px, 10vw, 140px); }
  .th-modes-grid { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .mode { border-radius: var(--radius); padding: clamp(28px, 4vw, 48px); border: 1px solid var(--line); background: var(--cream); display: grid; gap: 14px; align-content: start; transition: transform .5s var(--ease); }
  .mode:hover { transform: translateY(-5px); }
  .mode.dark { background: var(--ink); color: #fff; border-color: var(--ink); }
  .mode-icon { width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: var(--brand); color: #fff; }
  .mode-k { font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--brand); }
  .mode.dark .mode-k { color: #7fd3d8; }
  .mode h3 { font: 400 clamp(26px, 2.4vw, 34px)/1.12 var(--font-display); margin: 0; }
  .mode p { margin: 0; line-height: 1.65; color: var(--ink-2); }
  .mode.dark p { color: rgba(255,255,255,.72); }
  .mode ul { list-style: none; padding: 0; margin: 6px 0 0; display: grid; gap: 10px; }
  .mode li { display: flex; gap: 10px; align-items: center; font-weight: 600; font-size: 15px; }
  .mode li::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--brand); flex: none; }

  /* Cómo ayuda */
  .th-help { background: var(--cream); padding-top: clamp(80px, 10vw, 140px); padding-bottom: clamp(80px, 10vw, 140px); }
  .th-help-list { max-width: 1240px; margin: 0 auto; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .th-help-list li { padding: 34px 30px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); display: grid; gap: 12px; align-content: start; transition: background-color .4s var(--ease); }
  .th-help-list li:hover { background: var(--paper); }
  .th-help-list li.hl-cta { background: var(--brand-soft); align-content: end; color: var(--ink); }
  .th-help-list li.hl-cta .link-arrow { justify-self: start; }
  .hl-icon { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; background: var(--brand-soft); color: var(--brand); }
  .th-help-list h3 { margin: 0; font: 400 23px/1.2 var(--font-display); color: var(--ink); }
  .th-help-list p { margin: 0; line-height: 1.6; color: var(--ink-2); font-size: 15.5px; }

  /* Pasos */
  .th-steps { background: var(--paper); padding-top: clamp(80px, 10vw, 130px); padding-bottom: clamp(80px, 10vw, 130px); scroll-margin-top: 90px; }
  .steps { position: relative; max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .steps-line { position: absolute; top: 22px; left: 32px; width: calc(66.6% + 10px); height: 20px; }
  .steps-line path { fill: none; stroke: var(--brand); stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 1; vector-effect: non-scaling-stroke; transition: stroke-dashoffset 2s var(--ease); }
  .steps:has(.step.is-in) .steps-line path { stroke-dashoffset: 0; }
  .step { position: relative; display: grid; gap: 12px; }
  .step-k {
    width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center;
    background: var(--ink); color: #fff; font: 400 22px/1 var(--font-display); position: relative; z-index: 1;
  }
  .step h3 { margin: 8px 0 0; font: 400 28px/1.15 var(--font-display); color: var(--ink); }
  .step p { margin: 0; color: var(--ink-2); line-height: 1.65; max-width: 36ch; }

  /* Sobre Gloria */
  .th-about { background: var(--ink); color: #fff; padding-top: clamp(80px, 10vw, 130px); padding-bottom: clamp(80px, 10vw, 130px); }
  .th-about-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 0.7fr 1.3fr; gap: clamp(30px, 6vw, 90px); align-items: center; }
  .th-about-card { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: var(--radius); padding: 14px; display: grid; gap: 14px; }
  .th-about-card img { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: top; border-radius: 18px; display: block; }
  .th-about-card div { display: grid; gap: 4px; padding: 0 6px 6px; }
  .th-about-card strong { font: 400 26px/1.1 var(--font-display); }
  .th-about-card span { font-size: 14px; color: rgba(255,255,255,.65); }
  .th-about-copy { display: grid; gap: 20px; }
  .th-about-copy p { margin: 0; font: 300 clamp(20px, 2vw, 27px)/1.5 var(--font-display); color: rgba(255,255,255,.9); }
  .eyebrow-v2.on-dark { color: #7fd3d8; }

  /* FAQ */
  .th-faq { background: var(--cream); padding-top: clamp(80px, 10vw, 130px); padding-bottom: clamp(60px, 8vw, 100px); }
  .th-faq-inner { max-width: 900px; margin: 0 auto; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding: 24px 4px; font: 400 clamp(20px, 2vw, 26px)/1.25 var(--font-display); color: var(--ink);
  }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); position: relative; flex: none; transition: transform .4s var(--ease), background-color .3s; }
  .faq-list summary span::before, .faq-list summary span::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.6px; background: var(--ink); transform: translate(-50%, -50%); }
  .faq-list summary span::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform .3s; }
  .faq-list details[open] summary span { background: var(--brand); border-color: var(--brand); }
  .faq-list details[open] summary span::before, .faq-list details[open] summary span::after { background: #fff; }
  .faq-list details[open] summary span::after { transform: translate(-50%, -50%) rotate(0); }
  .faq-list details p { margin: 0 4px 26px; color: var(--ink-2); line-height: 1.7; font-size: 16.5px; max-width: 70ch; }
  .th-crisis { margin: 36px 0 0; display: flex; gap: 12px; align-items: flex-start; padding: 18px 20px; border-radius: var(--radius-sm); background: var(--paper); border: 1px solid var(--line); color: var(--ink-2); font-size: 14.5px; line-height: 1.6; }
  .th-crisis i { color: var(--brand); font-size: 18px; }

  /* Cierre */
  .th-close { background: var(--paper); text-align: center; padding-top: clamp(90px, 11vw, 150px); padding-bottom: 70px; }
  .th-close .h-display { font-size: clamp(42px, 6.4vw, 98px); }
  .th-close > p { color: var(--ink-2); font-size: 17px; margin: 22px auto 30px; }
  .th-close-actions { display: flex; justify-content: center; align-items: center; gap: 24px; flex-wrap: wrap; color: var(--ink); }
  .th-disc { margin: 64px auto 0 !important; max-width: 80ch; font-size: 12.5px !important; color: var(--ink-2) !important; }

  @media (max-width: 960px) {
    .th-hero { grid-template-columns: 1fr; padding-top: 130px; min-height: 0; }
    .th-modes-grid, .th-about-inner { grid-template-columns: 1fr; }
    .th-help-list { grid-template-columns: 1fr 1fr; }
    .steps { grid-template-columns: 1fr; }
    .steps-line { display: none; }
    .th-about-card { max-width: 360px; }
  }
  @media (max-width: 600px) {
    .th-help-list { grid-template-columns: 1fr; }
  }
</style>
