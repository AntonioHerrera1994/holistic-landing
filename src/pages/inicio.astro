---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/v2/SiteNav.astro';
import HomeHero from '../components/v2/HomeHero.astro';
import ServicePanels from '../components/v2/ServicePanels.astro';
import HomeSections from '../components/v2/HomeSections.astro';
import ExpertsSlider from '../components/v2/ExpertsSlider.astro';
import Footer from '../components/espanol/FooterEsp.astro';
import { home } from '../i18n/content';
const t = home.es;
---

<Layout title={t.seoTitle} description={t.seoDesc} lang="es">
	<SiteNav lang="es" />
	<main>
		<HomeHero lang="es" />
		<HomeSections lang="es" part="marquee" />
		<ServicePanels lang="es" />
		<HomeSections lang="es" part="why" />
		<ExpertsSlider lang="es" />
		<HomeSections lang="es" part="closing" />
	</main>
	<Footer />
</Layout>
