---
import SeoHead from '../components/v2/SeoHead.astro';
import Navbar from '../components/Navbar.astro';
import ServicesHero from '../components/ServicesHero.astro';
import ServiciosPG from'../components/ServiciosPg.astro';
import Procedimientos from '../components/Procedimientos.astro';
import Footer from '../components/Footer.astro';
import Faqs from '../components/Faqs.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<SeoHead lang="en" title="Complementary Treatments | Holistic Cancer Coach" description="Complementary therapies in Tijuana — hyperthermia, nutrition, rehabilitation and more — within a supervised plan that works alongside conventional care." />
	</head>
	<body>
		<Navbar solid/>
		<main>
		<ServicesHero />
		<ServiciosPG />
		<Procedimientos />
		<Faqs />
		</main>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
