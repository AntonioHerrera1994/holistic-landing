---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/v2/SiteNav.astro';
import HomeHero from '../components/v2/HomeHero.astro';
import ServicePanels from '../components/v2/ServicePanels.astro';
import HomeSections from '../components/v2/HomeSections.astro';
import ExpertsSlider from '../components/v2/ExpertsSlider.astro';
import Footer from '../components/Footer.astro';
import { home } from '../i18n/content';
const t = home.en;
---

<Layout title={t.seoTitle} description={t.seoDesc} lang="en">
	<SiteNav lang="en" />
	<main>
		<HomeHero lang="en" />
		<HomeSections lang="en" part="marquee" />
		<ServicePanels lang="en" />
		<HomeSections lang="en" part="why" />
		<ExpertsSlider lang="en" />
		<HomeSections lang="en" part="closing" />
	</main>
	<Footer />
</Layout>
