---
import SeoHead from '../components/v2/SeoHead.astro';
import Navbar from '../components/Navbar.astro';
import AboutHero from '../components/AboutHero.astro';
import Historia from '../components/Historia.astro';
import Eligenos from '../components/Eligenos.astro';
import Testimonios from '../components/Testimonios.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<SeoHead lang="en" title="About Us | Holistic Cancer Coach Team in Tijuana" description="Meet our multidisciplinary team in Tijuana: physicians, nutrition, holistic dentistry and patient support, working alongside your conventional medical care." />
	</head>
	<body>
		<Navbar solid/>
		<main>
		<AboutHero />
		<Historia />
		<Eligenos />
		{/* REVISAR (legal): testimonios ocultos hasta contar con reseñas reales verificadas y autorización por escrito de cada paciente. */}
		{/* <Testimonios /> */}
		</main>
		<Footer />
	</body>
</html>

<style>

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

