---
import SeoHead from '../components/v2/SeoHead.astro';
import NavBarEsp from'../components/espanol/NavbarEsp.astro'
import FooterEsp from '../components/espanol/FooterEsp.astro'
import ServiciosHeroEsp from '../components/espanol/ServiciosHeroEsp.astro'
import ServiciosPgEsp from '../components/espanol/ServiciosPgEsp.astro'
import ProcedimientosEsp from '../components/espanol/ProcedimientosEsp.astro'
import FaqsEsp from '../components/espanol/FaqsEsp.astro'
---

<!doctype html>
<html lang="es">
	<head>
		<SeoHead lang="es" title="Tratamientos complementarios | Holistic Cancer Coach" description="Terapias complementarias en Tijuana: hipertermia, nutrición, rehabilitación y más, dentro de un plan supervisado que acompaña tu tratamiento convencional." />
	</head>
	<body>
	     <NavBarEsp solid/>
		<main>
        <ServiciosHeroEsp />
		<ServiciosPgEsp />
		 <ProcedimientosEsp />
		 <FaqsEsp />
		</main>
        <FooterEsp />
           
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
