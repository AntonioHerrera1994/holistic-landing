---
import SeoHead from '../components/v2/SeoHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/blog.css'

const { pageTitle } = Astro.props;
const blogs = await Astro.glob('../pages/blog/*.md');
---
<!doctype html>
<html lang="en">
	<head>
		<SeoHead lang="en" title="Blog | Holistic Cancer Coach" description="Educational articles on nutrition, recovery and integrative care from the Holistic Cancer Treatments Coach team." />
	</head>
	<body>
		<Navbar solid/>
		<main>
        
          <section class="blog-section" id="blog-section">
            <header class="blog-head">
              <h1>Blog</h1>
              <p>Educational articles on nutrition, recovery and integrative care. Information only — not a substitute for medical advice.</p>
            </header>
            <div class="grid-cont">
            
              <ul class="blogs">
                {blogs.map((blog) =>
                  <li>
                    <article class="blog">          
                      <img src={blog.frontmatter.image.url} alt={blog.frontmatter.title} width="800" height="450" loading="lazy" style="width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;" />
                      <a href={blog.url} class=""><h2 class="blog-card-title">{blog.frontmatter.title}</h2></a>
                      <p class="blog-date"><strong>{blog.frontmatter.date}</strong></p>
                      <p>{blog.frontmatter.description}</p>
          
                    </article>            
                  </li>
                )}
              </ul>
            </div>
          </section>
		</main>
        <Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>